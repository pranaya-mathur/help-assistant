# Staging / production-like local stack (use with docker-compose.staging.yml)
# cp .env.staging.example .env.staging && fill secrets

OPENAI_API_KEY=your_openai_api_key_here
APIFY_API_TOKEN=your_apify_api_token_here

APP_ENV=production
API_PORT=8080
API_RELOAD=false
AUTO_INGEST_ON_START=true
UVICORN_WORKERS=1
REDIS_WAIT_SECONDS=60

# Multi-instance backends (requires redis service in docker-compose)
SESSION_STORE_BACKEND=redis
RATE_LIMIT_BACKEND=redis
REDIS_URL=redis://redis:6379/0
TRUST_PROXY_HEADERS=false

# Retrieval — hybrid + pilot help mode on staging/devapi
HYBRID_RETRIEVAL_ENABLED=true
OPERATING_MODE=help
LLM_SUGGESTED_REPLIES_ENABLED=false
ENABLE_LEAD_QUALIFICATION=false
GROUNDING_REPLACE_ON_FAILURE=false
PAGE_CONTEXT_BOOST_ENABLED=false
EXPOSE_INTERNAL_SALES_METADATA=false

# Optional integrations
# HUBSPOT_WEBHOOK_URL=https://your-staging-webhook.example/hook
# ANALYTICS_WEBHOOK_URL=https://your-analytics.example/events
# APOLLO_API_KEY=

CORS_ALLOWED_ORIGINS=https://mobcoder.ai,https://www.mobcoder.ai,http://localhost:8765,http://127.0.0.1:8765
CALENDLY_URL=https://calendly.com/hello-mobcoder/mobcoderai
CONTACT_PAGE_URL=https://mobcoder.ai/contact-us
BOOKING_CTA=Book a 30-minute discovery call with Mobcoder AI
CHROMA_PERSIST_DIR=./data/embeddings/chroma
SESSION_DB_PATH=./data/sessions/chat_sessions.db
