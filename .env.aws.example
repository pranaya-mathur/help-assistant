# AWS production — API only (ECS Fargate + RDS + ElastiCache)
# Copy to .env.aws for local reference; runtime secrets live in AWS Secrets Manager.
# Full guide: docs/DEVOPS_DEPLOY.md and docs/AWS.md

APP_ENV=production
API_PORT=8080
API_RELOAD=false
AUTO_INGEST_ON_START=true
UVICORN_WORKERS=1

# Session + analytics (Amazon RDS PostgreSQL)
SESSION_STORE_BACKEND=postgres
# Set via Secrets Manager at runtime — example shape only:
# DATABASE_URL=postgresql://mobcoder:SECRET@your-rds.xxxxx.us-east-1.rds.amazonaws.com:5432/mobcoder
AUTO_MIGRATE_DB=true
PERSIST_ANALYTICS_EVENTS=true
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=10

# Rate limiting (Amazon ElastiCache Redis)
RATE_LIMIT_BACKEND=redis
# REDIS_URL=redis://your-cache.xxxxx.use1.cache.amazonaws.com:6379/0
REDIS_WAIT_SECONDS=60

# Behind ALB — required in AWS
TRUST_PROXY_HEADERS=true
FORWARDED_ALLOW_IPS=*

# Security / surface area
ENABLE_DOCS=false
ENABLE_SOURCE_ENDPOINTS=false
ENABLE_DEBUG_ENDPOINTS=false
EXPOSE_INTERNAL_SALES_METADATA=false
ENABLE_LEAD_QUALIFICATION=true
ENABLE_CHAT_STREAMING=true
ENABLE_LLM_GROUNDING=true
GROUNDING_PROVIDER=heuristic

# Retrieval (EFS mount on ECS — see deploy/terraform)
CHROMA_PERSIST_DIR=/mnt/efs/chroma
BM25_INDEX_PATH=/mnt/efs/indexes/bm25_index.pkl
HYBRID_RETRIEVAL_ENABLED=false
RERANKER_TOP_K=6
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATE_K=16

# CORS — website + dev pilot widget (match deploy/terraform cors_allowed_origins)
CORS_ALLOWED_ORIGINS=https://devweb-agent.mobcoder.ai,https://mobcoder.ai,https://www.mobcoder.ai

# Sales assistant URLs (defaults match settings.py if unset)
CALENDLY_URL=https://calendly.com/hello-mobcoder/mobcoderai
CONTACT_PAGE_URL=https://mobcoder.ai/contact-us
BOOKING_CTA=Book a 30-minute discovery call with Mobcoder AI

# Rate limits
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_EVENTS_PER_MINUTE=120

# Secrets (store in AWS Secrets Manager — not plain env in ECS task)
# OPENAI_API_KEY=
# APIFY_API_TOKEN=
# HUBSPOT_WEBHOOK_URL=
# ANALYTICS_WEBHOOK_URL=
# APOLLO_API_KEY=
# INTERNAL_API_KEY=

# Optional
# APOLLO_IP_ENRICHMENT_ENABLED=false
