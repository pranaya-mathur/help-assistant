# Required
APIFY_API_TOKEN=your_apify_api_token_here
OPENAI_API_KEY=your_openai_api_key_here

# LLM
OPENAI_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Vector DB
VECTOR_DB_TYPE=chroma
CHROMA_PERSIST_DIR=./data/embeddings/chroma

# Chunking
CHUNK_MIN_TOKENS=300
CHUNK_MAX_TOKENS=700
CHUNK_OVERLAP_TOKENS=75

# Retrieval
RETRIEVAL_TOP_K=8
RERANKER_TOP_K=4
RETRIEVAL_CANDIDATE_K=16
HYBRID_RETRIEVAL_ENABLED=false
# Pilot help mode: cp .env.pilot.example and merge, or set:
# OPERATING_MODE=help
# GROUNDING_REPLACE_ON_FAILURE=false
# ENABLE_LEAD_QUALIFICATION=false
BM25_INDEX_PATH=./data/indexes/bm25_index.pkl
BM25_TOP_K=20
VECTOR_TOP_K=20
HYBRID_RRF_K=60
HYBRID_FINAL_TOP_K=8
HYBRID_MIN_BM25_SCORE=0.0
HYBRID_FAIL_OPEN=true
RERANKER_BACKEND=heuristic
# COHERE_API_KEY=
# COHERE_RERANK_MODEL=rerank-english-v3.0
# QUERY_REWRITE_ENABLED=false
# PAGE_CONTEXT_BOOST_ENABLED=true
# LLM_SUGGESTED_REPLIES_ENABLED=true
# ENABLE_OTEL=false
# OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Crawling
APIFY_ACTOR_ID=apify/website-content-crawler
CRAWL_MAX_PAGES_PER_SEED=100
# Use: python scripts/crawl_mobcoder.py --use-sitemap --max-pages 100
CRAWL_ALLOWED_DOMAINS=mobcoder.ai,www.mobcoder.ai

# API
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8001
API_RELOAD=true
SESSION_DB_PATH=./data/sessions/chat_sessions.db
# Default for bare-metal dev (uvicorn on host). Docker Compose overrides to Postgres.
SESSION_STORE_BACKEND=sqlite
# Postgres (used by docker compose and production)
# SESSION_STORE_BACKEND=postgres
# DATABASE_URL=postgresql://mobcoder:mobcoder@localhost:5432/mobcoder
# AUTO_MIGRATE_DB=true
# PERSIST_ANALYTICS_EVENTS=true
# POSTGRES_POOL_MIN_SIZE=1
# POSTGRES_POOL_MAX_SIZE=10
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_BACKEND=memory
# Optional per-endpoint overrides (default: RATE_LIMIT_PER_MINUTE)
# RATE_LIMIT_CHAT_PER_MINUTE=20
# RATE_LIMIT_EVENTS_PER_MINUTE=120
# RATE_LIMIT_ESCALATE_PER_MINUTE=10
# RATE_LIMIT_FEEDBACK_PER_MINUTE=30
# TRUST_PROXY_HEADERS=true only behind an ingress that overwrites X-Forwarded-For/X-Real-IP
TRUST_PROXY_HEADERS=false
# REDIS_URL=redis://localhost:6379/0
# Production multi-instance: SESSION_STORE_BACKEND=redis, RATE_LIMIT_BACKEND=redis
CORS_ALLOWED_ORIGINS=https://mobcoder.ai,https://www.mobcoder.ai,https://devweb-agent.mobcoder.ai,http://localhost:3000,http://127.0.0.1:7860,http://127.0.0.1:8765,http://localhost:8765
# In APP_ENV=production these default to false unless explicitly enabled
# ENABLE_DOCS=false
# ENABLE_SOURCE_ENDPOINTS=false
# ENABLE_DEBUG_ENDPOINTS=false
# EXPOSE_INTERNAL_SALES_METADATA=false

# Sales assistant
# Set false to stop "tell us about your project" prompts and the qualify form
ENABLE_LEAD_QUALIFICATION=true
# Keep false in production: a true caller could inject fabricated conversation_history
# to manipulate intent/lead extraction/CRM. Only enable for stateless local scripting.
TRUST_CLIENT_CONVERSATION_HISTORY=false
CALENDLY_URL=https://calendly.com/hello-mobcoder/mobcoderai
CONTACT_PAGE_URL=https://mobcoder.ai/contact-us
BOOKING_CTA=Book a 30-minute discovery call with Mobcoder AI
EVAL_DATASET_PATH=./data/evals/golden_questions.json
EVAL_MIN_PASS_RATE=0.90

# Grounding — validates generated answers against retrieved context, prevents hallucinations
ENABLE_LLM_GROUNDING=true
GROUNDING_PROVIDER=heuristic

# Streaming — enables SSE token streaming for instant perceived response time
ENABLE_CHAT_STREAMING=true
# ANALYTICS_WEBHOOK_URL=

# Internal API key — gates GET /api/v1/feedback and GET /api/v1/feedback/stats
# Required for QA team and admin tooling. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave unset in dev to disable the endpoints entirely.
# INTERNAL_API_KEY=

# Optional integrations
# Apollo People Match — POST https://api.apollo.io/api/v1/people/match (X-Api-Key header)
# Enriches lead profile when email and/or company is known (chat hints + CRM dispatch).
# APOLLO_API_KEY=
# HUBSPOT_WEBHOOK_URL=
# Google Sheets lead log (Apps Script web app) — docs/GOOGLE_SHEETS_LEAD_LOG.md
# GOOGLE_SHEETS_WEBHOOK_URL=
# Google Chat human-review alerts — docs/GOOGLE_CHAT_LEAD_ALERTS.md
# GOOGLE_CHAT_WEBHOOK_URL=
# APOLLO_IP_ENRICHMENT_ENABLED=false

# AWS production (API only) — see docs/AWS.md and .env.aws.example
# SESSION_STORE_BACKEND=postgres
# DATABASE_URL=postgresql://user:pass@your-rds-host:5432/mobcoder
# REDIS_URL=redis://your-elasticache-host:6379/0
# AUTO_MIGRATE_DB=true
# TRUST_PROXY_HEADERS=true

# Widget (browser)
# MOBCODER_CHAT_API_URL=https://your-api.example.com/api/v1/chat
# MOBCODER_SHOW_DEBUG_SALES_STATE=false
# MOBCODER_PRIVACY_COPY=By sharing your details, you agree that Mobcoder AI may contact you about your inquiry. Please avoid sharing sensitive personal information in chat.
