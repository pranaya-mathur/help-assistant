# Pilot help-assistant configuration (local + devapi)
# cp .env.pilot.example .env  OR merge into deployed env on devapi-chatbot
# EC2 deploy: prefer .env.devops.example (same pilot flags, production stack)

OPENAI_API_KEY=your_openai_api_key_here

# Help-only pilot — no inline qualify, no profile LLM on hot path
OPERATING_MODE=help
# Vector-only for pilot stability (matches .env.devops.example). Set true locally
# only after `python scripts/eval_retrieval.py` shows measurable lift.
HYBRID_RETRIEVAL_ENABLED=false
LLM_SUGGESTED_REPLIES_ENABLED=false
ENABLE_LEAD_QUALIFICATION=false
GROUNDING_REPLACE_ON_FAILURE=false
PAGE_CONTEXT_BOOST_ENABLED=false

OPENAI_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

APP_ENV=development
API_PORT=8001
API_RELOAD=false

CHROMA_PERSIST_DIR=./data/embeddings/chroma
BM25_INDEX_PATH=./data/indexes/bm25_index.pkl
SESSION_DB_PATH=./data/sessions/chat_sessions.db

CORS_ALLOWED_ORIGINS=https://mobcoder.ai,https://www.mobcoder.ai,https://devweb-agent.mobcoder.ai,http://127.0.0.1:8765,http://localhost:8765
CALENDLY_URL=https://calendly.com/hello-mobcoder/mobcoderai
CONTACT_PAGE_URL=https://mobcoder.ai/contact-us

# Gates /admin, GET /feedback*, and GET /leads. Unset = disabled (404).
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# INTERNAL_API_KEY=

# After changing corpus metadata, re-ingest:
# python scripts/ingest.py --reset-collection
