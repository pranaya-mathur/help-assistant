# =============================================================================
# DevOps handoff — canonical EC2 env template (API on devapi-chatbot.mobcoder.ai)
# =============================================================================
# Full guide: docs/DEVOPS_DEPLOY.md
#
# On EC2 server (one-time):
#   cp .env.devops.example .env.production
#   # Fill OPENAI_API_KEY and APIFY_API_TOKEN below
#
# Start / update stack:
#   docker compose -f docker-compose.ec2.yml --env-file .env.production up -d
#
# CI/CD: push to main → .github/workflows/deploy-ec2.yml (builds image, deploys via SSH)
#
# DO NOT commit .env.production with real keys to git.
# Share secrets via 1Password / AWS Secrets Manager / private channel only.
# =============================================================================

# --- Secrets (REQUIRED — DevOps fills on server) ---
OPENAI_API_KEY=REPLACE_ME
APIFY_API_TOKEN=REPLACE_ME

# --- App ---
APP_ENV=production
API_PORT=8080
API_RELOAD=false
AUTO_INGEST_ON_START=true
UVICORN_WORKERS=1

# --- Postgres + Redis (docker-compose.ec2.yml on same host) ---
SESSION_STORE_BACKEND=postgres
DATABASE_URL=postgresql://mobcoder:mobcoder@postgres:5432/mobcoder
AUTO_MIGRATE_DB=true
PERSIST_ANALYTICS_EVENTS=true
RATE_LIMIT_BACKEND=redis
REDIS_URL=redis://redis:6379/0
REDIS_WAIT_SECONDS=60

# --- Behind nginx on EC2 / ALB ---
TRUST_PROXY_HEADERS=true
FORWARDED_ALLOW_IPS=*

# --- Security (production-like on dev server) ---
ENABLE_DOCS=false
ENABLE_SOURCE_ENDPOINTS=false
ENABLE_DEBUG_ENDPOINTS=false
EXPOSE_INTERNAL_SALES_METADATA=false
ENABLE_LEAD_QUALIFICATION=true
ENABLE_CHAT_STREAMING=true
ENABLE_LLM_GROUNDING=true
GROUNDING_PROVIDER=heuristic

# --- Retrieval (Docker volume app_data) ---
VECTOR_DB_TYPE=chroma
CHROMA_PERSIST_DIR=./data/embeddings/chroma
BM25_INDEX_PATH=./data/indexes/bm25_index.pkl
HYBRID_RETRIEVAL_ENABLED=false
RERANKER_TOP_K=6
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATE_K=16

# --- CORS — dev widget + mobcoder.ai (required for browser chat) ---
CORS_ALLOWED_ORIGINS=https://devweb-agent.mobcoder.ai,https://mobcoder.ai,https://www.mobcoder.ai

# --- Widget + API (separate AWS hosts) ---
# Browser-only globals for embed docs — not read by the API server:
# Widget (S3/CloudFront): https://devweb-agent.mobcoder.ai  → scripts/aws/deploy_widget_dev.sh
# API (EC2/ALB):         https://devapi-chatbot.mobcoder.ai
# MOBCODER_WIDGET_URL=https://devweb-agent.mobcoder.ai
# MOBCODER_DEV_API_BASE=https://devapi-chatbot.mobcoder.ai
# MOBCODER_CHAT_API_URL=https://devapi-chatbot.mobcoder.ai/api/v1/chat

# --- Sales / booking ---
CALENDLY_URL=https://calendly.com/hello-mobcoder/mobcoderai
BOOKING_CTA=Book a 30-minute discovery call with Mobcoder AI
CONTACT_PAGE_URL=https://mobcoder.ai/contact-us

# --- Optional integrations ---
# HUBSPOT_WEBHOOK_URL=
# ANALYTICS_WEBHOOK_URL=
# APOLLO_API_KEY=
# INTERNAL_API_KEY=

# --- LLM ---
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Rate limits ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_EVENTS_PER_MINUTE=120
