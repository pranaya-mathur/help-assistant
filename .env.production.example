# Production Docker stack (use with docker-compose.prod.yml)
# cp .env.production.example .env.production && fill secrets

OPENAI_API_KEY=your_openai_api_key_here
APIFY_API_TOKEN=your_apify_api_token_here

APP_ENV=production
API_PORT=8080
API_RELOAD=false
AUTO_INGEST_ON_START=true
UVICORN_WORKERS=1

# Shared state across replicas (required for multi-instance)
SESSION_STORE_BACKEND=postgres
DATABASE_URL=postgresql://mobcoder:mobcoder@postgres:5432/mobcoder
AUTO_MIGRATE_DB=true
PERSIST_ANALYTICS_EVENTS=true
RATE_LIMIT_BACKEND=redis
REDIS_URL=redis://redis:6379/0
REDIS_WAIT_SECONDS=60
TRUST_PROXY_HEADERS=true
FORWARDED_ALLOW_IPS=*

# Security / surface area
ENABLE_DOCS=false
ENABLE_SOURCE_ENDPOINTS=false
ENABLE_DEBUG_ENDPOINTS=false
EXPOSE_INTERNAL_SALES_METADATA=false
ENABLE_LEAD_QUALIFICATION=true
ENABLE_CHAT_STREAMING=true
ENABLE_LLM_GROUNDING=true
GROUNDING_PROVIDER=heuristic

# Sales assistant URLs
CALENDLY_URL=https://calendly.com/hello-mobcoder/mobcoderai
CONTACT_PAGE_URL=https://mobcoder.ai/contact-us
BOOKING_CTA=Book a 30-minute discovery call with Mobcoder AI

# Retrieval
RERANKER_TOP_K=6
HYBRID_RETRIEVAL_ENABLED=false

# Paths inside container (persisted on app_data volume)
CHROMA_PERSIST_DIR=./data/embeddings/chroma
SESSION_DB_PATH=./data/sessions/chat_sessions.db

CORS_ALLOWED_ORIGINS=https://mobcoder.ai,https://www.mobcoder.ai,https://devweb-agent.mobcoder.ai,http://localhost:8765,http://127.0.0.1:8765

# Internal QA/ops API key — gates GET /api/v1/feedback, /feedback/stats, and /leads
# (used by /admin, the read-only ops portal). Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Share only with the QA/ops team, via your secrets manager — never commit the
# real value. Leave unset and these endpoints stay disabled (404), and /admin
# will load but every request from it will fail with "unauthorized".
# INTERNAL_API_KEY=

# Optional integrations
# HUBSPOT_WEBHOOK_URL=
# GOOGLE_SHEETS_WEBHOOK_URL=   # docs/GOOGLE_SHEETS_LEAD_LOG.md
# GOOGLE_CHAT_WEBHOOK_URL=     # docs/GOOGLE_CHAT_LEAD_ALERTS.md
# ANALYTICS_WEBHOOK_URL=
# APOLLO_API_KEY=
# APOLLO_IP_ENRICHMENT_ENABLED=false
